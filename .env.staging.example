# Staging environment variables (names only — no secrets)

# Public (safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://your-staging-host.example

# Content mode — production for live staging (demo must stay off)
NABDA_CONTENT_MODE=production
# Do NOT set NEXT_PUBLIC_NABDA_CONTENT_MODE=demo on staging
# NEXT_PUBLIC_NABDA_CONTENT_MODE=

# Source rendering (default on unless set to 0)
NABDA_SOURCE_RENDER=1

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Private staging gate (optional but recommended) — server only
STAGING_ACCESS_SECRET=

# Optional: LAN preview origins for next.dev
# ALLOWED_DEV_ORIGINS=

# Optional live RLS users (server-only)
# NABDA_TEST_USER_A_EMAIL=
# NABDA_TEST_USER_A_PASSWORD=
# NABDA_TEST_USER_B_EMAIL=
# NABDA_TEST_USER_B_PASSWORD=
# NABDA_TEST_STAFF_EMAIL=
# NABDA_TEST_STAFF_PASSWORD=
