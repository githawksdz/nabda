# NABDA_PRO_COUPON_CAMPAIGN_ID=pro-coupon-env
 NABDA_PRO_COUPON_CURRENT_DZD=250
 NABDA_PRO_COUPON_ORIGINAL_DZD=375
 NABDA_PRO_COUPON_ENDS_AT=2026-10-31T23:59:59+01:00
 NABDA_PRO_COUPON_PERIOD=month

