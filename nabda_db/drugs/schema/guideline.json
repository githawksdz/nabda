{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nabda.dz/schema/drugs/guideline.json",
  "title": "Treatment guideline (reco)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "body_html", "source_context", "locale_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^g\\." },
    "title": { "type": "string" },
    "body_html": { "type": "string" },
    "substance_ids": { "type": "array", "items": { "type": "string" } },
    "source_context": { "type": "string" },
    "locale_status": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "object" }
  }
}
