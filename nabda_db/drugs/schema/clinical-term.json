{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nabda.dz/schema/drugs/clinical-term.json",
  "title": "Indication, contraindication, or side effect",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "kind": { "type": "string", "enum": ["indication", "contraindication", "side_effect"] },
    "type": { "type": ["string", "null"] },
    "sources": { "type": "object" }
  }
}
