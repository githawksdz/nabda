{
  "id": "p.salicylique-na-cutanee-topique",
  "presentation_id": "p.salicylique-na-cutanee-topique",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Solution pour application cutanée.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Acide salicylique</span><span class=\"style_81425f2c\">...........................................................................................................................................</span><span class=\"style_99bc9fff\"> 11,0 g</span></p> \n<p class=\"style_9f47fc39\"><span class=\"style_99bc9fff\">Pour 100 g de solution pour application cutanée.</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Acide acétique, huile de ricin, essence de térébenthine officinale, éthanol à 96 %, colophane, collodion.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Traitement local d'appoint des cors, durillons, œil-de-perdrix et verrues.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Posologie</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Appliquer sur la surface à traiter 1 à 2 fois par jour en veillant à ne pas déborder sur la peau saine : protéger la peau saine au moyen d'un protège-cor.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Bien refermer le flacon après usage.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Laisser sécher. Au bout d'une semaine de traitement, éliminer les tissus mortifiés après avoir pris un bain de pieds chaud.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La durée de traitement est généralement en cas de cor, durillons, œil-de-perdrix, de 5 à 6 jours et en cas de verrues, de 2 semaines.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Mode d'administration</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Voie cutanée.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Allergie à un des composants.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Cors infectés.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Mises en garde spéciale</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">L'utilisation des coricides doit faire l'objet de beaucoup de prudence chez les artéritiques, les diabétiques et les sujets atteints de neuropathies.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En raison du risque de passage systémique, ce produit ne doit pas être appliqué sur de grande surface.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En raison de la présence d'éthanol à 96 % (320 mg par mL), ce médicament peut provoquer des irritations cutanées.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Précaution d'emploi</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En cas d'échec du traitement, la conduite à tenir doit être réévaluée. Il peut être utile de rechercher la cause et de la traiter en conséquence (mesures orthopédiques de correction de l'appui, modification du chaussage).</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ne pas utiliser sur les muqueuses.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ne pas déborder sur la peau saine.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ce médicament contient de l'huile de ricin. Peut provoquer des réactions cutanées.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les données disponibles à ce jour ne laissent pas supposer l'existence d'interactions cliniquement significatives.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Grossesse</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Il n'existe pas ou peu de données sur l'utilisation de salicylique, solution p applic cutanée 11 g/100 g, solution pour application cutanée pendant la grossesse.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">salicylique, solution p applic cutanée 11 g/100 g, solution pour application cutanée ne doit pas être utilisé pendant la grossesse, à l'exception du traitement unique et à court terme d'une verrue, d'un cor, ou d'un oeil-de-perdrix de petite taille.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">On ignore si l'exposition systémique de salicylique, solution p applic cutanée 11 g/100 g, solution pour application cutanée obtenue après une administration topique peut être nocive pour un embryon / un foetus.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Au cours du troisième trimestre de grossesse, l'utilisation systémique d'inhibiteurs de prostaglandine-synthétase peut induire une toxicité cardiopulmonaire et rénale chez le foetus. À la fin de la grossesse, des temps de saignements prolongés peuvent survenir tant chez la mère que chez l'enfant, et le travail peut être retardé.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Allaitement</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">A utiliser avec prudence chez la femme qui allaite, faute de données cliniques exploitables.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"ei\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Irritation de la peau en cas d'application sur la peau saine.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Risque de phénomène d'irritation cutanée et de sensation de brûlure.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet :</span><span class=\"style_6224636e\"> </span><a href=\"https://signalement.social-sante.gouv.fr\" class=\"style_287f0f63\">https://signalement.social-sante.gouv.fr</a></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Risque de brûlures en cas de surdosage.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: VERRUCIDES ET CORICIDES code ATC&#xa0;: D11AF.</span></strong></p><br /></div>\n </div>\n\n\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">3 ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Produit inflammable, à tenir éloigné de toute source de chaleur.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"manip\" data-source-date=\"Fri Jan 16 00:00:00 CET 2026\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Bien refermer le flacon après usage.</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400930942147 (Fl/5ml+protect).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>Eurodep Pharma</b><br />\n                4 RUE COPERNIC <br />\n                77290 COMPANS<br />\n                Tél : 01 60 94 85 85\n                \n                \n                exploitant@eurodep.fr<br />\n                https://www.eurodep.fr/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
