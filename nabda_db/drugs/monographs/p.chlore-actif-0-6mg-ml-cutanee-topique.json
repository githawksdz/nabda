{
  "id": "p.chlore-actif-0-6mg-ml-cutanee-topique",
  "presentation_id": "p.chlore-actif-0-6mg-ml-cutanee-topique",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Solution pour application cutanée.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Solution aqueuse d'hypochlorite de sodium</span><span class=\"style_81425f2c\">.........................................................................................</span><span class=\"style_99bc9fff\"> 5,00 mL</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Quantité correspondant à chlore actif</span><span class=\"style_81425f2c\">.......................................................................................................</span><span class=\"style_99bc9fff\"> 0,06 g</span></p> \n<p class=\"style_9f47fc39\"><span class=\"style_99bc9fff\">Pour 100 ml de solution pour application cutanée</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">substance, solution injectable, Hydroxyde de sodium, Hydrogénocarbonate de sodium, Eau purifiée.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Antisepsie de la peau, des muqueuses (dont la conjonctive) et des plaies.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les agents à visée antiseptique ne sont pas stérilisants, ils réduisent temporairement le nombre de micro-organismes.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Posologie et </span></strong><strong><span class=\"style_99bc9fff\">Mode d'administration</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les applications locales d'chlore actif 0.6 mg/ml, solution p applic cutanée se font sans dilution :</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• soit en lavages, en bains locaux ou en irrigations.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• soit en compresses imbibées ou en pansements humides.</span></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Renouveler le traitement selon les besoins.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Dose maximale journalière&#xa0;: 4,2 mL</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Hypersensibilité à l'hypochlorite de sodium (au chlore).</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ce médicament est réservé à l'usage externe.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Un passage transcutané ne peut être exclu, par conséquent l'utilisation d'chlore actif 0.6 mg/ml, solution p applic cutanée doit se faire avec précaution dans certaines situations : sur une grande surface, sous pansement occlusif, sur une peau lésée (notamment brûlée).</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Irritation possible sous pansement occlusif.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Dès l'ouverture du flacon, une contamination microbienne est possible. Ne pas garder trop longtemps un flacon d'antiseptique entamé.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Compte tenu des interférences possibles (antagonisme, inactivation) l'emploi simultané ou successif d'antiseptiques ou de savon est à éviter.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les données disponibles à ce jour ne laissent pas supposer l'existence d'interactions cliniquement significatives.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Compte tenu des données disponibles, l'utilisation chez la femme enceinte ou qui allaite est possible.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"ei\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_2a7fabd2\">•</span><span class=\"style_abeaa273\"> </span><span class=\"style_99bc9fff\">Sensation de brûlure ou d'irritation principalement sur peau lésée (plaies importantes, chirurgie gynécologique) ne justifiant pas habituellement l'arrêt du traitement</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet :</span><span class=\"style_6224636e\"> </span><a href=\"https://signalement.social-sante.gouv.fr/\" class=\"style_287f0f63\">https://signalement.social-sante.gouv.fr/</a><span class=\"style_99bc9fff\">.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En cas d'ingestion accidentelle, l'antidote est le bicarbonate de sodium.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: ANTISEPTIQUES ET DESINFECTANTS (D. DERMATOLOGIE). code ATC&#xa0;: DO8AX07.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Antiseptique local du groupe chimique des chlorés à large spectre d'activité: bactéricide, fongicide, virucide.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Impropre à la désinfection du matériel médico-chirurgical.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les matières organiques (protéines, sérum, sang) diminuent l'activité antiseptique.</span></p><br /></div>\n </div>\n\n\n\n <div data-rubric=\"incomp\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "incompatibilites": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INCOMPATIBILITÉS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Compte-tenu des interférences possibles (antagonisme, inactivation) l'emploi simultané ou successif d'antiseptiques ou de savon est à éviter sans un rinçage soigneux intermédiaire.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"durcons\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">24 mois&#xa0;: flacons PVC</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">30 mois&#xa0;: flacons PE</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Flacons PE&#xa0;: Conserver dans le flacon soigneusement fermé à l'abri de la lumière.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Flacons PVC&#xa0;: A conserver à une température ne dépassant pas 30°C. Conserver dans le flacon soigneusement fermé à l'abri de la lumière.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Utiliser dans les 6 mois après ouverture.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"manip\" data-source-date=\"Sat Dec 09 00:00:00 CET 2023\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Pas d'exigences particulières.</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400933683504 (Fl PE/250ml).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n                    Collect.<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>Gifrer Barbezat</b><br />\n                10 AVENUE DES CANUTS - BP 165 <br />\n                69120 VAULX-EN-VELIN<br />\n                Tél : 09 70 80 93 39\n                \n                \n                contact@gifrer.fr<br />\n                https://www.gifrer.fr/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
  },
