  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p align=\"left\">Pâte dentifrice.</p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Thu Feb 15 00:00:00 CET 1990\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p align=\"left\" class=\"style_6a239503\">substance, solution injectable ..................................................... 15,000&#xa0;g</p> \n<p align=\"left\">dont sel marin ......................................................... 1,000&#xa0;g</p> \n<p align=\"center\">Pour un tube de 100&#xa0;g.</p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Thu Feb 15 00:00:00 CET 1990\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p align=\"left\">Carbonate de calcium, silice colloïdale anhydre, glycérol, polyéthylèneglycol 1500, gomme adragante, alcool éthylique à 95&#xa0;°, huile essentielle de badiane, huile essentielle de menthe poivrée, rouge cochenille A (E 124), eau purifiée qs.</p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Thu Feb 15 00:00:00 CET 1990\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p align=\"left\">Parodontopathies.</p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Thu Feb 15 00:00:00 CET 1990\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p align=\"left\" class=\"style_6a239503\">Masser les gencives pendant au moins une minute avec une brosse douce après chaque repas et avant le coucher.</p> \n<p align=\"left\">Laisser agir pendant quelques minutes.</p><br /></div>\n </div>\n\n\n\n\n\n\n\n\n <div data-rubric=\"dynami\" data-source-date=\"Thu Feb 15 00:00:00 CET 1990\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p align=\"left\" class=\"style_6a239503\">Pâte dentifrice au sel marin.</p> \n<p align=\"left\">La pâte dentifrice SELGINE possède des propriétés hygroscopiques et osmotiques. Elle stimule la sécrétion salivaire et améliore la vascularisation du tissu gingival, permettant ainsi d'observer une hygiène bucco-dentaire quotidienne rationnelle.</p><br /></div>\n </div>\n\n\n\n\n\n\n\n <div data-rubric=\"dosi\" data-source-date=\"Thu Feb 15 00:00:00 CET 1990\" data-is-edited=\"false\">",
    "dosi": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DOSIMÉTRIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p align=\"left\">[A compléter ultérieurement par le titulaire]</p><br /></div>\n </div>\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400931390527 (T/100g).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>Teofarma SRL</b><br />\n                VIA F.LLI CERVI, 8 <br />\n                27010 VALLE SALIMBENE (PAVIA)<br />\n                Tél : 00 39 0382 422 008\n                \n                \n                amministrazione@teofarma.it<br />\n                https://www.teofarmasrl.it/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
