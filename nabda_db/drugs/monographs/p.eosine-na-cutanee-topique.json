{
  "id": "p.eosine-na-cutanee-topique",
  "presentation_id": "p.eosine-na-cutanee-topique",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Solution pour application locale.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Eosine disodique </span><span class=\"style_81425f2c\">........................................................................................................................................................</span><span class=\"style_99bc9fff\">2,00 g</span></p> \n<p class=\"style_c4c9e0aa\"><span class=\"style_99bc9fff\">Pour 100 ml de solution.</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Eau purifiée.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Ce médicament est indiqué en cas d'irritation de la peau, notamment en cas d'érythème fessier (fesses rouges) du nourrisson.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Voie cutanée.</span></p> \n<p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Une à deux fois par jour, appliquer localement à l'aide d'une compresse stérile ou verser directement sur l'endroit à traiter.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Hypersensibilité à l'éosine.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_c04c7bbf\"><u><strong><span class=\"style_99bc9fff\">Précautions d'emploi</span></strong></u></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Tout flacon entamé doit être utilisé dans les 48 heures pour éviter toute contamination microbienne.</span></p> \n<p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Ne pas avaler.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Compte-tenu des interférences possibles, l'emploi simultané ou successif avec d'autres solutions à application locale est à éviter.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">A utiliser avec prudence chez la femme enceinte faute de données cliniques exploitables. Peut être utilisé durant l'allaitement</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"ei\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Risque de photosensibilisation et d'éruptions cutanées localisées.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"dynami\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_868c6b0a\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: D08AX02</span></strong></p> \n<p class=\"style_f800d8db\"><strong><span class=\"style_99bc9fff\">Autres antiseptiques et désinfectants</span></strong></p> \n<p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">(D. Médicaments dermatologiques)</span></strong></p> \n<p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">La présentation en flacon unidose stérile évite le risque de contamination bactérienne.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"cineti\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "pharmacocinetique": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACOCINÉTIQUE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">L'hydrosolubilité de l'éosine exclut quasiment une pénétration cutanée.</span></p><br /></div>\n </div>\n\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">2 ans</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">A conserver à une température inférieure à 25°C.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"manip\" data-source-date=\"Thu Jun 07 00:00:00 CEST 2012\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Pas d'exigences particulières.</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
