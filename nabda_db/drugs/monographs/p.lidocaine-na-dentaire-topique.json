{
  "id": "p.lidocaine-na-dentaire-topique",
  "presentation_id": "p.lidocaine-na-dentaire-topique",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Crème pour usage dentaire</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">adrenaline + lidocaine, solution injectable</span><span class=\"style_81425f2c\">...........................................................................................................................................................</span><span class=\"style_99bc9fff\">7,48 g</span></p> \n<p class=\"style_cc418ae7\"><span class=\"style_99bc9fff\">pour 100 g de crème pour usage dentaire</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Arôme verveine*, Stéarates de glycérile et de macrogol 4000, Eau purifiée.</span></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">* composition de l'arôme verveine&#xa0;: citral (néral, géranial), huile essentielle de citron, alpha terpinéol, linalol.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Anesthésie locale de surface lors&#xa0;de :</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Anesthésie d'infiltration,</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Taille et pose de couronnes et pilier de bridge,</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Détartrage juxta-gingival et sous-gingival.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Administration locale stricte - Voie gingivale</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Au point d'injection ou de travail et après séchage de la muqueuse, appliquer une sphérule de crème de 2 mm environ de diamètre.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Procéder à un léger massage digital ou à l'aide d'une boulette de coton, afin d'obtenir une action anesthésique rapide et prolongée.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• L'anesthésie intervient en 1 à 2 minutes</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Enlever l'excès de crème avec une petite compresse.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Hypersensibilité à l'un des constituants de la formule, en particulier à la adrenaline + lidocaine, solution injectable ou aux anesthésiques locaux.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Ne pas avaler</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Tenir compte d'un risque de résorption plus rapide et plus importante de la adrenaline + lidocaine, solution injectable en cas de muqueuse buccale lésée</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• En raison de l'anesthésie locale, un risque de morsures (lèvres, joues, muqueuses, langue) est à prendre en compte.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• L'attention des sportifs sera attirée sur le fait que ce médicament contient un principe actif pouvant induire une réaction positive des tests pratiqués lors des contrôles anti-dopage.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Les interactions connues avec la adrenaline + lidocaine, solution injectable (antiarythmiques, bêta-bloquants) en principe ne concernent pas l'utilisation par voie locale sur la muqueuse de la cavité buccale. Cependant, tenir compte d'un risque de passage systémique de la adrenaline + lidocaine, solution injectable en cas de muqueuse buccale lésée</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Compte-tenu des données disponibles, l'utilisation chez la femme enceinte ou qui allaite est possible.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"ei\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Risque d'allergie.</span></p> \n<p class=\"style_02277aca\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet :</span><span class=\"style_6224636e\"> </span><a href=\"https://signalement.social-sante.gouv.fr/\" class=\"style_287f0f63\">https://signalement.social-sante.gouv.fr/</a><span class=\"style_e499692d\">.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Dans les conditions normales d'utilisation en odontostomatologie, aucun effet de surdosage n'a été rapporté. Toutefois, dans le cas où une dose supérieure aux doses préconisées était administrée, les manifestations de toxicité neurologique ou cardiovasculaire éventuelles seraient alors traitées par l'injection d'un barbiturique de courte durée d'action ou d'une benzodiazépine, l'oxygénation et la ventilation assistée.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: ANESTHESIQUE A USAGE DENTAIRE, code ATC&#xa0;:&#xa0;N01BB02</span></strong></p> \n<p class=\"style_02277aca\"><u><strong><span class=\"style_99bc9fff\">Mécanisme d'action</span></strong></u></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">adrenaline + lidocaine, solution injectable&#xa0;: anesthésique local du groupe des amino-amides.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"cineti\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "pharmacocinetique": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACOCINÉTIQUE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_02277aca\"><u><strong><span class=\"style_99bc9fff\">Absorption</span></strong></u></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Après application locale, l'absorption systémique de la adrenaline + lidocaine, solution injectable est limitée.</span></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Toutefois, certaines parties de la muqueuse peuvent être plus perméables que d'autres.</span></p> \n<p class=\"style_02277aca\"><u><strong><span class=\"style_99bc9fff\">Distribution</span></strong></u></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">La vitesse de résorption dépend notamment de l'état de vascularisation.</span></p> \n<p class=\"style_02277aca\"><u><strong><span class=\"style_99bc9fff\">É</span></strong><strong><span class=\"style_99bc9fff\">limination</span></strong></u></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Son métabolisme est hépatique et son élimination urinaire, essentiellement sous forme métabolisée. Les métabolites actifs sont le mono-éthyl-glycine-xylidine (MEGX) et la glycine-xylidine (GX).</span></p><br /></div>\n </div>\n\n <div data-rubric=\"seccli\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "securite_preclinique": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SÉCURITÉ PRÉCLINIQUE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Les études effectuées sur l'animal ont montré la bonne tolérance de la adrenaline + lidocaine, solution injectable.</span></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Comme les autres anesthésiques locaux à fonction amide, le principe actif, à doses élevées, peut induire des réactions toxiques sur le système nerveux central et/ou le système cardiovasculaire.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">3 ans</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">A conserver à une température inférieure à 25 °C.</span></p> \n<p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Bien refermer le tube après usage.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"manip\" data-source-date=\"Mon Jun 03 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_d7ec645a\"><span class=\"style_99bc9fff\">Pas d'exigences particulières</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\tListe II<br />\n\t\t\tMédicament réservé à l'usage professionnel : dentiste.<br />\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400950029897 (T/15g).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n                    Collect.<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>Pierre Rolland</b><br />\n                GROUPE ACTEON 17 AVENUE GUSTAVE EIFFEL - BP 30216<br />\n                33708 MERIGNAC CEDEX<br />\n                Tél : 05 56 34 06 07\n                \n                Tél (n° Vert) : 0 810 811 400<br />\n                pierre-rolland.int@acteongroup.com<br />\n                https://www.acteongroup.com/en/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
  },
