{
  "id": "p.camphre-levomenthol-na-inhalee-inhalation",
  "presentation_id": "p.camphre-levomenthol-na-inhalee-inhalation",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Tampon imprégné pour inhalation par fumigation.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Camphre racémique</span><span class=\"style_81425f2c\">....................................................................................................................................</span><span class=\"style_99bc9fff\">39,671&#xa0;g</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Lévomenthol</span><span class=\"style_81425f2c\">..................................................................................................................................................</span><span class=\"style_99bc9fff\">39,671&#xa0;g</span></p> \n<p class=\"style_9f47fc39\"><span class=\"style_99bc9fff\">Pour 100&#xa0;ml de solution.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">1 ml de solution imprègne un tampon d'acétate de cellulose, placé dans la partie médiane du tube.</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Huile essentielle d'aiguilles de sapin de Sibérie, salicylate de méthyle.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Décongestionnant au cours des affections respiratoires banales (rhumes, rhinites, rhinopharyngites) chez l'adulte et l'enfant de plus de 12&#xa0;ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Posologie</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">RESERVE A L'ADULTE ET A L'ENFANT DE PLUS DE 12&#xa0;ANS.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">2 inspirations par narine et par prise, à renouveler si nécessaire sans dépasser 3 prises par jour, en répartissant les prises régulièrement dans la journée.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La durée du traitement est limitée à 3 jours.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Mode d'administration</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Voie respiratoire.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Appliquer à chaque narine, appuyer sur la narine controlatérale pour la maintenir fermée et inspirer.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Hypersensibilité aux substances actives ou à l'un des excipients mentionnés à la rubrique <a href=\"#compo\">Composition</a>.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Enfants ayant des antécédents de convulsions (fébriles ou non).</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Enfants de moins de 2 ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• En cas de réaction allergique, suspendre le traitement.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• En cas de persistance des symptômes au-delà de 3 jours et/ou d'apparition des signes de surinfection, il conviendra de réévaluer la conduite thérapeutique.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Cette spécialité contient des terpènes qui peuvent entraîner à doses excessives des accidents à type de convulsions chez l'enfant : ne pas dépasser 2 inspirations par narine et 3 prises par jour.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• En cas d'antécédents d'épilepsie, tenir compte de la présence de terpènes.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Eviter tout contact avec les yeux en raison du risque d'irritation. En cas de contact rincer abondamment à l'eau.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les données disponibles à ce jour ne laissent pas supposer l'existence d'interactions cliniquement significatives.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Allaitement</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">L'utilisation de ce médicament est à éviter pendant l'allaitement dans la mesure&#xa0;:</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• où ces médicaments ont une toxicité neurologique,</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• où les données sur le passage dans le lait sont absentes.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"machin\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "conduite": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONDUITE et UTILISATION DE MACHINES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">VICKS INHALER, tampon imprégné pour inhalation par fumigation n'a aucun effet ou un effet négligeable sur l'aptitude à conduire des véhicules et à utiliser des machines.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ei\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Réaction d'hypersensibilité (fréquence indéterminée).</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Irritation locale (fréquence indéterminée).</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Gêne nasale (fréquence indéterminée).</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• En cas de non-respect des doses préconisées&#xa0;:</span></p> \n<ul type=\"circle\" class=\"style_b4d2eb2a\"> \n <li class=\"style_b3e70fcb\"><span class=\"style_99bc9fff\">risque de convulsions chez l'enfant,</span></li> \n <li class=\"style_b3e70fcb\"><span class=\"style_99bc9fff\">possibilité d'agitation et de confusion chez les sujets âgés.</span></li> \n</ul> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet&#xa0;:</span><span class=\"style_6224636e\"> </span><a href=\"https://signalement.social-sante.gouv.fr/\" class=\"style_287f0f63\">https://signalement.social-sante.gouv.fr/</a><span class=\"style_99bc9fff\">.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Aucun cas de surdosage cliniquement significatif n'a été rapporté.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: à visée décongestionnante, code ATC&#xa0;: R05X</span></strong></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les dérivés terpéniques peuvent abaisser le seuil épileptogène.</span></p><br /></div>\n </div>\n\n\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">3 ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">A conserver à une température inférieure à 25°C.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"manip\" data-source-date=\"Thu May 23 00:00:00 CEST 2024\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Pas d'exigences particulières.</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400931126621 (T/1ml).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>P&amp;G Health France</b><br />\n                163-165 QUAI AULAGNIER <br />\n                92265 ASNIERES-SUR-SEINE CEDEX<br />\n                Tél : 03 80 78 74 00\n                \n                Tél (n° Vert) : 0800 944 803<br />\n                \n                https://fr.pg.com/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
