{
  "id": "p.hexamidine-lidocaine-na-auriculaire-solution-auriculaire",
  "presentation_id": "p.hexamidine-lidocaine-na-auriculaire-solution-auriculaire",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Gouttes auriculaires.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Di-iséthionate d'hexamidine ..........................................................................................................0,100&#xa0;g</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Chlorhydrate de adrenaline + lidocaine, solution injectable ........................................................................................................... 0,100&#xa0;g</span></p> \n<p class=\"style_9f47fc39\"><span class=\"style_99bc9fff\">Pour 100&#xa0;ml.</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Glycérine officinale, alcool éthylique à 95°.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Traitement antiseptique des otites externes à tympan fermé et de leurs manifestations douloureuses.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Posologie</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Adultes&#xa0;: 4 gouttes 3 fois par jour.</span></p> \n<p class=\"style_310fc412\"><u><em><span class=\"style_99bc9fff\">Population pédiatrique</span></em></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Nourrissons et enfants&#xa0;: 2 gouttes 3 fois par jour.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Durée du traitement</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">5 jours.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Hypersensibilité aux substances actives ou à l'un des excipients mentionnés à la rubrique <a href=\"#compo\">Composition</a>.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Il est impératif de faire vérifier l'état du tympan avant toute utilisation en raison des risques de toxicité pour l'oreille en cas de perforation du tympan.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Aucune étude d'interaction n'a été réalisée.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Grossesse</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Il n'y a pas de données fiables de tératogénèse chez l'animal. En clinique aucun effet malformatif ou foetotoxique particulier n'est apparu à ce jour. Toutefois, le suivi de grossesses exposées est insuffisant pour exclure tout risque.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En conséquence, par mesure de précaution, il est préférable de ne pas utiliser ce médicament pendant la grossesse.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"machin\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "conduite": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONDUITE et UTILISATION DE MACHINES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les effets sur l'aptitude à conduire des véhicules et à utiliser des machines n'ont pas été étudiés.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ei\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Comme tout produit actif ce médicament peut entraîner chez certaines personnes des effets plus ou moins gênants.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet&#xa0;:</span><span class=\"style_6224636e\"></span><a href=\"http://www.signalement-sante.gouv.fr\" class=\"style_287f0f63\">www.signalement-sante.gouv.fr</a><span class=\"style_99bc9fff\">.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Aucun cas de surdosage n'a été rapporté.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: médicaments otologiques, code ATC&#xa0;: S02DA01.</span></strong></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Préparation à usage auriculaire associant un antiseptique local de la famille des diamidines (di-iséthionate d'hexamidine) et un anesthésique locale (chlorhydrate de adrenaline + lidocaine, solution injectable).</span></p><br /></div>\n </div>\n\n\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">2 ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Mon Feb 17 00:00:00 CET 2020\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">A conserver à une température ne dépassant pas 30°C.</span></p><br /></div>\n </div>\n\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400932296835 (Fl/15ml).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>P&amp;G Health France</b><br />\n                163-165 QUAI AULAGNIER <br />\n                92265 ASNIERES-SUR-SEINE CEDEX<br />\n                Tél : 03 80 78 74 00\n                \n                Tél (n° Vert) : 0800 944 803<br />\n                \n                https://fr.pg.com/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
  },
