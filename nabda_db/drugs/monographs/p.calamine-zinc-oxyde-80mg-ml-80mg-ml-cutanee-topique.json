{
  "id": "p.calamine-zinc-oxyde-80mg-ml-80mg-ml-cutanee-topique",
  "presentation_id": "p.calamine-zinc-oxyde-80mg-ml-80mg-ml-cutanee-topique",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Gel pour application locale.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Oxyde de zinc&#xa0;……………………………………..…………………………………………………..….8,000 g</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Calamine ……………………………………………………………………………...…………………..8,000 g</span></p> \n<p class=\"style_9f47fc39\"><span class=\"style_99bc9fff\">Pour 100 ml de gel pour application locale.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Excipient à effet notoire&#xa0;: chlorure de benzalkonium.</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Chlorure de benzalkonium, hydroxyéthylcellulose sodique, glycérol, eau purifiée.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Traitement d'appoint des dermites irritatives.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Posologie</span></strong></u></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Appliquer 2 à 3 fois par jour en couche mince, sur la surface à traiter. Laisser sécher.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Mode d'administration</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Sans objet.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Sensibilité aux ammoniums quaternaires.</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• Dermatoses infectées</span></p> \n<p class=\"style_f800d8db\"><span class=\"style_99bc9fff\">• &#xa0;Dermatoses suintantes</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ce médicament contient 20 mg de chlorure de benzalkonium par 100 ml. Le chlorure de benzalkonium peut irriter la peau.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Vous ne devez pas appliquer ce médicament sur les seins si vous allaitez car le bébé pourrait l'absorber avec le lait.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les données disponibles à ce jour ne laissent pas supposer l'existence d'interactions cliniquement significatives.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Cependant, éviter toujours l'application simultanée ou successive d'un autre produit pour application locale.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">A utiliser avec prudence chez la femme enceinte ou qui allaite, faute de données cliniques exploitables. Ne pas appliquer sur les seins durant l'allaitement.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"ei\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Possibles réactions cutanées, eczéma de contact.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet :</span><span class=\"style_6224636e\"> </span><a href=\"https://signalement.social-sante.gouv.fr/\" class=\"style_287f0f63\">https://signalement.social-sante.gouv.fr/</a><span class=\"style_99bc9fff\">.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">L'application de trop fortes doses risque d'entrainer une exacerbation des effets indésirables.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En cas de surdosage, rincer abondamment à l'eau.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: PROTECTEUR CUTANE, code ATC&#xa0;: D02AB PRODUITS A BASE DE ZINC</span></strong></p><br /></div>\n </div>\n\n\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">3 ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Pas de condition particulière de conservation.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"manip\" data-source-date=\"Tue Oct 17 00:00:00 CEST 2023\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Pas d'exigence particulière.</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400933976309 (T/50ml).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>Therica</b><br />\n                15 AV HENRI DUNANT <br />\n                27400 LOUVIERS<br />\n                Tél : 02 32 40 03 99\n                \n                \n                \n                \n        </center>\n\n    </div>\n\t\n\n</div>"
