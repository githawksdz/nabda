{
  "id": "p.pentosane-polysulfate-na-cutanee-topique",
  "presentation_id": "p.pentosane-polysulfate-na-cutanee-topique",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Crème.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Polyester sulfurique de pentosane .............................................................................................. 0,500 g</span></p> \n<p class=\"style_9f47fc39\"><span class=\"style_99bc9fff\">Pour 100 g de crème.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Excipients à effet notoire&#xa0;: propylène glycol, parahydroxybenzoate de méthyle</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Cire émulsionnante non ionique au cétostéaromacrogol, huile de maïs polyglycolysée, glycérol, propylèneglycol (E1520), parahydroxybenzoate de méthyle (E218), acide lévulinique, hydroxyde de sodium, eau purifiée.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Traitement local d'appoint en traumatologie bénigne (ecchymoses, contusions) chez l'adulte et l'enfant à partir d'un an.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Posologie</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Appliquer 2 à 4 fois par jour sur la région à traiter en massant très légèrement pour faciliter la pénétration.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Mode d'administration</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Voie cutanée. Application locale.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_9720d1ca\"><span class=\"style_99bc9fff\">• Antécédents d'allergie ou de thrombocytopénies aux héparines ou aux héparinoïdes.</span></p> \n<p class=\"style_9720d1ca\"><span class=\"style_99bc9fff\">• Hypersensibilité aux autres constituants (parahydroxybenzoate de méthyle et propylène glycol).</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Pour usage externe exclusivement. Ne pas avaler.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ce médicament contient du propylèneglycol et peut provoquer des irritations cutanées.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ce médicament contient du «&#xa0;Parahydroxybenzoate&#xa0;» et peut provoquer des réactions allergiques (éventuellement retardées).</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Arrêter le traitement en cas de manifestations allergiques.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ne pas appliquer au voisinage immédiat des yeux, sur les muqueuses, les plaies, les brûlures, les lésions infectées ou sur les dermatoses suintantes.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Bien se laver les mains après chaque utilisation (afin d'éviter tout contact avec les yeux ou les muqueuses).</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"groall\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">L'expérimentation animale est insuffisante pour établir la sécurité vis-à-vis de la reproduction, du déroulement de la grossesse, du développement de l'embryon ou du fœtus et du développement péri et post natal.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Chez la femme enceinte ou qui allaite, l'innocuité d'HÉMOCLAR 0,5 pour cent, crème n'a pas été évaluée par des essais cliniques contrôlés et les données post-commercialisation sont insuffisantes.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Par conséquent l'utilisation d'HÉMOCLAR 0,5 pour cent, crème n'est pas recommandée au cours de la grossesse ou de l'allaitement.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"ei\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Possibilité de réactions allergiques localisées au point d'application.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En raison de la présence de propylèneglycol, ce médicament peut provoquer une irritation cutanée.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En raison de la présence de parahydroxybenzoate de méthyle, ce médicament peut provoquer des réactions allergiques (éventuellement retardées).</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet :</span><span class=\"style_6224636e\"> </span><a href=\"https://signalement.social-sante.gouv.fr/\" class=\"style_287f0f63\">https://signalement.social-sante.gouv.fr/</a><span class=\"style_99bc9fff\">.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Aucun cas de surdosage n'a été rapporté, cependant une utilisation excessive pourra entraîner une exacerbation des effets indésirables, notamment l'irritation cutanée.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: PRODUIT LOCAL POUR LES DOULEURS MUSCULAIRES ET ARTICULAIRES. (M : système locomoteur)</span></strong></p><br /></div>\n </div>\n\n\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">2 ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Tue Sep 30 00:00:00 CEST 2025\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">A conserver à une température ne dépassant pas 25°C.</span></p><br /></div>\n </div>\n\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400930479308 (T/30g).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>Coopération Pharmaceutique Française</b><br />\n                PLACE LUCIEN AUVERT <br />\n                77020 MELUN CEDEX<br />\n                Tél : 01 64 87 20 00\n                \n                \n                \n                https://www.cooper.fr/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
  },
