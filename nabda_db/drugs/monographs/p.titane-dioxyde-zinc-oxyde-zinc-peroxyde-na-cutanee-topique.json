{
  "id": "p.titane-dioxyde-zinc-oxyde-zinc-peroxyde-na-cutanee-topique",
  "presentation_id": "p.titane-dioxyde-zinc-oxyde-zinc-peroxyde-na-cutanee-topique",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Pâte pour application cutanée.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Oxyde de zinc</span><span class=\"style_81425f2c\">.............................................................................................................................................</span><span class=\"style_99bc9fff\"> 28,30 g</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Peroxyde de zinc à 70 % (m/m)</span><span class=\"style_81425f2c\">.................................................................................................................</span><span class=\"style_99bc9fff\"> 7,70 g</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Dioxyde de titane</span><span class=\"style_81425f2c\">..........................................................................................................................................</span><span class=\"style_99bc9fff\"> 0,20 g</span></p> \n<p class=\"style_9f47fc39\"><span class=\"style_99bc9fff\">Pour 100 g de pâte pour application cutanée.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Excipient(s) à effet notoire&#xa0;: Lanoline.</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Terre d'infusoires (Celite 209), vaseline, lanoline, amidon de maïs.</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Traitement local d'appoint des ulcérations cutanées.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Posologie</span></strong></u></p> \n<p class=\"style_310fc412\"><u><em><span class=\"style_99bc9fff\">Population pédiatrique</span></em></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Sans objet.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Mode d'administration</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Voie cutanée.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Appliquer sur une compresse une épaisseur de 1 centimètre de pâte.</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Poser doucement sur l'ulcération. Maintenir avec un pansement classique.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><ul type=\"disc\" class=\"style_b4d2eb2a\"> \n <li class=\"style_d7f2d8ee\"><span class=\"style_99bc9fff\">Hypersensibilité aux substances actives ou à l'un des excipients mentionnés à la rubrique <a href=\"#compo\">Composition</a>.</span></li> \n <li class=\"style_d7f2d8ee\"><span class=\"style_99bc9fff\">Lésions infectées.</span></li> \n</ul><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Ce médicament contient de la lanoline et peut provoquer des réactions cutanées locales (par exemple: eczéma).</span></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">En l'absence de données sur la résorption transcutanée, le risque d'effets systémiques ne peut être exclu ; il est d'autant plus à redouter que le topique est utilisé sur une grande surface, sous pansement occlusif, sur une peau lésée (notamment brûlée), une muqueuse, une peau de prématuré ou de nourrisson (en raison du rapport surface/poids et de l'effet d'occlusion des couches au niveau du siège).</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Les données disponibles à ce jour ne laissent pas supposer l'existence d'interactions cliniquement significatives.</span></p><br /></div>\n </div>\n\n\n\n <div data-rubric=\"ei\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Possibilité d'eczéma de contact causé par la lanoline.</span></p> \n<p class=\"style_6f2f2c6c\"><u><strong><span class=\"style_99bc9fff\">Déclaration des effets indésirables suspectés</span></strong></u></p> \n<p class=\"style_310fc412\"><span class=\"style_99bc9fff\">La déclaration des effets indésirables suspectés après autorisation du médicament est importante. Elle permet une surveillance continue du rapport bénéfice/risque du médicament. Les professionnels de santé déclarent tout effet indésirable suspecté via le système national de déclaration&#xa0;: Agence nationale de sécurité du médicament et des produits de santé (ANSM) et réseau des Centres Régionaux de Pharmacovigilance - Site internet :</span><span class=\"style_6224636e\"> </span><a href=\"http://www.ansm.sante.fr\" class=\"style_287f0f63\">www.ansm.sante.fr</a><span class=\"style_99bc9fff\">.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Aucun surdosage n'a été rapporté.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique&#xa0;: MEDICAMENTS A BASE DE ZINC, code ATC&#xa0;: D02AB.</span></strong></p> \n<p class=\"style_310fc412\"><strong><span class=\"style_99bc9fff\">(D&#xa0;: Dermatologie).</span></strong></p><br /></div>\n </div>\n\n\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">3 ans.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"manip\" data-source-date=\"Tue May 29 00:00:00 CEST 2018\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_310fc412\"><span class=\"style_99bc9fff\">Pas d'exigences particulières.</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400930121856 (Pot/190g).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n         <div>\n                    Non Remb Séc soc.\n<br />\n         </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>H2 Pharma</b><br />\n                ZA LA CROIX BONNET 21 RUE JACQUES TATI<br />\n                78390 BOIS D'ARCY<br />\n                Tél : 01 30 47 84 70 \n                \n                \n                \n                www.h2pharma.com<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
