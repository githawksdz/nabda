{
  "id": "p.salicylique-na-cutanee-emplatre-medicamente",
  "presentation_id": "p.salicylique-na-cutanee-emplatre-medicamente",
  "sections": {
    "formes": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FORMES et PRÉSENTATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\">\n \n <i><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Emplâtre.</span></p></i>\n </div>\n </div>\n\n <div data-rubric=\"compo\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "composition": "<br /><table border=\"0\">\n <tbody><tr>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>COMPOSITION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Acide salicylique </span><span class=\"style_81425f2c\">.........................................................................................................................................................</span><span class=\"style_99bc9fff\">40,0 g</span></p> \n<p class=\"style_c4c9e0aa\"><span class=\"style_99bc9fff\">Pour 100 g d'emplâtre.</span></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Excipients à effet notoire&#xa0;: lanoline (graisse de laine), latex (caoutchouc).</span></p><br /></div>\n <div data-rubric=\"excip\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">\n <u>Excipients : </u>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Dammar Kauri, graisse de laine (lanoline), cire d'abeille jaune, caoutchouc (latex), colophane, chlorophylle cuivrique (E141).</span></p><br /></div>\n </div>\n </div>\n\n <div data-rubric=\"ind\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "indications": "<br /><table border=\"0\">\n\t<tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n\t</tr>\n\t</tbody></table>\n\t<div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Traitement local d'appoint des cors, durillons et œil-de-perdrix.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"posmad\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "posologie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>POSOLOGIE ET MODE D'ADMINISTRATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Chaque soir, effectuer l'application d'un emplâtre après la toilette du pied pendant 3 à 5 jours.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ci\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "contre_indications": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>CONTRE-INDICATIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Allergie à un des composants</span></p> \n<p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Cors infectés</span></p><br /></div>\n </div>\n\n <div data-rubric=\"megpe\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "mises_en_garde": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>MISES EN GARDE et PRÉCAUTIONS D'EMPLOI</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_c04c7bbf\"><u><strong><span class=\"style_99bc9fff\">Mises en garde</span></strong><strong><span class=\"style_99bc9fff\"> spéciales</span></strong></u></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">L'utilisation des coricides doit faire l'objet de beaucoup de prudence chez les artéritiques, les diabétiques et les sujets atteints de neuropathies.</span></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Ce produit est caustique. Ne pas déborder en dehors de la zone à traiter.</span></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Arrêter l'application en cas de survenue de douleurs.</span></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Ce médicament contient de la lanoline (graisse de laine) et peut provoquer des réactions cutanées locales (par exemple&#xa0;: eczéma).</span></p> \n<p class=\"style_c72ea156\"><span class=\"style_99bc9fff\">Cette spécialité contient du latex (caoutchouc) qui peut causer, chez les personnes allergiques au latex, des réactions allergiques graves.</span></p> \n<p class=\"style_c04c7bbf\"><u><strong><span class=\"style_99bc9fff\">Précaution d'emploi</span></strong></u></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">En cas d'échec du traitement, la conduite à tenir doit être réévaluée, il peut être utile de rechercher la cause et de la traiter en conséquence (mesures orthopédiques de correction de l'appui, modification du chaussage).</span></p> \n<p class=\"style_6f2f2c6c\"><span class=\"style_99bc9fff\">Ne pas utiliser sur les muqueuses.</span></p> \n<p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Ne pas déborder sur la peau saine.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"interact\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "interactions": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>INTERACTIONS</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Les données disponibles à ce jour ne laissent pas supposer l'existence d'interactions cliniquement significatives.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"groall\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "grossesse": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>FERTILITÉ/GROSSESSE/ALLAITEMENT</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">A utiliser avec prudence chez la femme enceinte ou qui allaite, faute de données cliniques exploitables.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"ei\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "effets_indesirables": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>EFFETS INDÉSIRABLES</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Irritation de la peau en cas d'application sur la peau saine.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"surdo\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "surdosage": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DC</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SURDOSAGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Risque de brûlures en cas de superposition de plusieurs emplâtres adhésifs.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"dynami\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "pharmacodynamie": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PHARMACODYNAMIE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_6f2f2c6c\"><strong><span class=\"style_99bc9fff\">Classe pharmacothérapeutique : KERATOLYTIQUE</span></strong></p> \n<p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">(</span><strong><span class=\"style_99bc9fff\">Dermatologie</span></strong><span class=\"style_99bc9fff\">)</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"seccli\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "securite_preclinique": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">PP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>SÉCURITÉ PRÉCLINIQUE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Les données non cliniques issues des études toxicologiques en administration répétée, irritation cutanée aiguë et pouvoir sensibilisant, ont permis de conclure que le produit ne devrait pas présenter de risque d'intolérance cutanée majeure ni de risque de sensibilisation cutanée dans les conditions normales et raisonnablement prévisibles d'emploi, en dehors de réactions individuelles, le produit ne devant pas être appliqué ni sur la peau saine ni sur une muqueuse.</span></p><br /></div>\n </div>\n\n\n <div data-rubric=\"durcons\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "conservation": "<br />\n <table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>DURÉE DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">5 ans.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"ppcons\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">\n<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES DE CONSERVATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">A conserver à une température ne dépassant pas 30° C.</span></p><br /></div>\n </div>\n\n <div data-rubric=\"manip\" data-source-date=\"Thu Oct 13 00:00:00 CEST 2011\" data-is-edited=\"false\">",
    "manipulation": "<br /><table border=\"0\">\n <tbody><tr>\n <td bgcolor=\"#990000\"><font face=\"verdana, Arial, Helvetica, sans-serif\" size=\"+1\" color=\"#ffffff\">DP</font></td>\n <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRÉCAUTIONS PARTICULIÈRES D'ÉLIMINATION ET DE MANIPULATION</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n </tr>\n </tbody></table>\n <div class=\"monoRecordRubric\"><p class=\"style_7a908bbd\"><span class=\"style_99bc9fff\">Pas d'exigences particulières.</span></p><br /></div>\n </div>\n\n\n\n <div id=\"dael\">",
    "prescription": "<br /><table border=\"0\">\n      <tbody><tr>\n         <td><font face=\"verdana, Arial, Helvetica, sans-serif\" color=\"#990000\"><b>PRESCRIPTION/DÉLIVRANCE/PRISE EN CHARGE</b></font>&#xa0;<a href=\"#pub\"><font face=\"Arial, Helvetica, sans-serif\" color=\"#0000ff\" size=\"2\"><sup>(début page)</sup></font></a></td>\n      </tr>\n      </tbody></table>\n      <div class=\"monoRecordRubric\">\n\t\t\n    </div>\n   <div>\n      <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n         <tbody>\n         <tr valign=\"top\">\n            <td width=\"12%\" style=\"padding:0\">AMM</td>\n            <td align=\"left\" style=\"padding:0\">\n               <table border=\"0\" width=\"90%\" cellpadding=\"0\" cellspacing=\"1\" style=\"margin-bottom:0\">\n                  <tbody>\n                     <tr valign=\"top\">\n                        <td align=\"left\" style=\"padding:0\">CIP 3400930397701 (Sach/1).</td>\n                     </tr>\n                  </tbody>\n               </table>\n            </td>\n        </tr>\n        </tbody>\n    </table>\n    </div>\n<br />\n   </div>\n\n    <div id=\"address_labo\">\n              <center class=\"adr\">\n            <b>Gilbert</b><br />\n                LABORATOIRES GILBERT AVENUE DU GENERAL DE GAULLE<br />\n                14200 HEROUVILLE ST-CLAIR CEDEX<br />\n                Tél : 02 31 47 15 15\n                \n                \n                labo-gilbert@groupebatteur.fr<br />\n                https://www.labogilbert.fr/<br />\n        </center>\n\n    </div>\n\t\n\n</div>"
