  "equation_logic_text": "var calc_output = [];\n\nvar d, kpa, kpb, bigk, lilk, bigm, bign, bigs, lils, fya, fyb, jka, jkb, bigc, lilc, bige, lile, cw, lea, leb, p1, lua, lub\n\nif (bigk == 1) {\n  if (race == 0) {\n    bigk = 1 - parseFloat(bigk_value_w) / 100\n  } else if (race == 1) {\n    bigk = 1 - parseFloat(bigk_value_b) / 100\n  } else if (race == 2) {\n    bigk = 1 - parseFloat(bigk_value_a) / 100\n  } \n}\nelse if (bigk == 0) {\n  bigk = 1\n}\n\nif (lilk == 1) {\n  if (race == 0) {\n    lilk = 1 - parseFloat(lilk_value_w) / 100\n  } else if (race == 1) {\n    lilk = 1 - parseFloat(lilk_value_b) / 100\n  } else if (race == 2) {\n    lilk = 1 - parseFloat(lilk_value_a) / 100\n  } \n}\nelse if (lilk == 0){\n  lilk = 1\n}\n\nif (bigm == 1) {\n  if (race == 0) {\n    bigm = 1 - parseFloat(bigm_value_w) / 100\n  } else if (race == 1) {\n    bigm = 1 - parseFloat(bigm_value_b) / 100\n  } else if (race == 2) {\n    bigm = 1 - parseFloat(bigm_value_a) / 100\n  } \n}\nelse if (bigm == 0){\n  bigm = 1\n}\n\nif (bign == 1) {\n  if (race == 0) {\n    bign = 1 - parseFloat(bign_value_w) / 100\n  } else if (race == 1) {\n    bign = 1 - parseFloat(bign_value_b) / 100\n  } else if (race == 2) {\n    bign = 1 - parseFloat(bign_value_a) / 100\n  } \n}\nelse if (bign == 0){\n  bign = 1\n}\n\nif (d == 1) {\n  if (race == 0) {\n    d = 1 - parseFloat(d_value_w) / 100\n  } else if (race == 1) {\n    d = 1 - parseFloat(d_value_b) / 100\n  } else if (race == 2) {\n    d = 1 - parseFloat(d_value_a) / 100\n  }\n}\nelse if (d == 0){\n  d = 1\n}\n\n\nif (kpa == 1) {\n  if (race == 0) {\n    kpa = 1 - parseFloat(kpa_value_w) / 100\n  } else if (race == 1) {\n    kpa = 1 - parseFloat(kpa_value_b) / 100\n  } else if (race == 2) {\n    kpa = 1 - parseFloat(kpa_value_a) / 100\n  } \n}\nelse if (kpa == 0){\n  kpa = 1\n}\n\nif (kpb == 1) {\n  if (race == 0) {\n    kpb = 1 - parseFloat(kpb_value_w) / 100\n  } else if (race == 1) {\n    kpb = 1 - parseFloat(kpb_value_b) / 100\n  } else if (race == 2) {\n    kpb = 1 - parseFloat(kpb_value_a) / 100\n  } \n}\nelse if (kpb == 0){\n  kpb = 1\n}\n\nif (bigs == 1) {\n  if (race == 0) {\n    bigs = 1 - parseFloat(bigs_value_w) / 100\n  } else if (race == 1) {\n    bigs = 1 - parseFloat(bigs_value_b) / 100\n  } else if (race == 2) {\n    bigs = 1 - parseFloat(bigs_value_a) / 100\n  } \n}\nelse if (bigs == 0){\n  bigs = 1\n}\n\nif (lils == 1) {\n  if (race == 0) {\n    lils = 1 - parseFloat(lils_value_w) / 100\n  } else if (race == 1) {\n    lils = 1 - parseFloat(lils_value_b) / 100\n  } else if (race == 2) {\n    lils = 1 - parseFloat(lils_value_a) / 100\n  } \n}\nelse if (lils == 0){\n  lils = 1\n}\n\nif (fya == 1) {\n  if (race == 0) {\n    fya = 1 - parseFloat(fya_value_w) / 100\n  } else if (race == 1) {\n    fya = 1 - parseFloat(fya_value_b) / 100\n  } else if (race == 2) {\n    fya = 1 - parseFloat(fya_value_a) / 100\n  }\n}\nelse if (fya == 0){\n  fya = 1\n}\n\nif (fyb == 1) {\n  if (race == 0) {\n    fyb = 1 - parseFloat(fyb_value_w) / 100\n  } else if (race == 1) {\n    fyb = 1 - parseFloat(fyb_value_b) / 100\n  } else if (race == 2) {\n    fyb = 1 - parseFloat(fyb_value_a) / 100\n  }\n}\nelse if (fyb == 0){\n  fyb = 1\n}\n\nif (jka == 1) {\n  if (race == 0) {\n    jka = 1 - parseFloat(jka_value_w) / 100\n  } else if (race == 1) {\n    jka = 1 - parseFloat(jka_value_b) / 100\n  } else if (race == 2) {\n    jka = 1 - parseFloat(jka_value_a) / 100\n  }\n}\nelse if (jka == 0){\n  jka = 1\n}\n\nif (jkb == 1) {\n  if (race == 0) {\n    jkb = 1 - parseFloat(jkb_value_w) / 100\n  } else if (race == 1) {\n    jkb = 1 - parseFloat(jkb_value_b) / 100\n  } else if (race == 2) {\n    jkb = 1 - parseFloat(jkb_value_a) / 100\n  }\n}\nelse if (jkb == 0){\n  jkb = 1\n}\n\nif (bigc == 1) {\n  if (race == 0) {\n    bigc = 1 - parseFloat(bigc_value_w) / 100\n  } else if (race == 1) {\n    bigc = 1 - parseFloat(bigc_value_b) / 100\n  } else if (race == 2) {\n    bigc = 1 - parseFloat(bigc_value_a) / 100\n  }\n \n}\nelse if (bigc == 0){\n  bigc = 1\n}\n\nif (lilc == 1) {\n  if (race == 0) {\n    lilc = 1 - parseFloat(lilc_value_w) / 100\n  } else if (race == 1) {\n    lilc = 1 - parseFloat(lilc_value_b) / 100\n  } else if (race == 2) {\n    lilc = 1 - parseFloat(lilc_value_a) / 100\n  }\n}\nelse if (lilc == 0){\n  lilc = 1\n}\n\nif (bige == 1) {\n  if (race == 0) {\n    bige = 1 - parseFloat(bige_value_w) / 100\n  } else if (race == 1) {\n    bige = 1 - parseFloat(bige_value_b) / 100\n  } else if (race == 2) {\n    bige = 1 - parseFloat(bige_value_a) / 100\n  }\n}\nelse if (bige == 0){\n  bige = 1\n}\n\nif (lile == 1) {\n  if (race == 0) {\n    lile = 1 - parseFloat(lile_value_w) / 100\n  } else if (race == 1) {\n    lile = 1 - parseFloat(lile_value_b) / 100\n  } else if (race == 2) {\n    lile = 1 - parseFloat(lile_value_a) / 100\n  }\n}\nelse if (lile == 0){\n  lile = 1\n}\n\nif (cw == 1) {\n  if (race == 0) {\n    cw = 1 - parseFloat(cw_value_w) / 100\n  } else if (race == 1) {\n    cw = 1 - parseFloat(cw_value_b) / 100\n  } else if (race == 2) {\n    cw = 1 - parseFloat(cw_value_a) / 100\n  }\n}\nelse if (cw == 0){\n  cw = 1\n}\n\nif (lea == 1) {\n  if (race == 0) {\n    lea = 1 - parseFloat(lea_value_w) / 100\n  } else if (race == 1) {\n    lea = 1 - parseFloat(lea_value_b) / 100\n  } else if (race == 2) {\n    lea = 1 - parseFloat(lea_value_a) / 100\n  }\n}\nelse if (lea == 0){\n  lea = 1\n}\n\nif (leb == 1) {\n  if (race == 0) {\n    leb = 1 - parseFloat(leb_value_w) / 100\n  } else if (race == 1) {\n    leb = 1 - parseFloat(leb_value_b) / 100\n  } else if (race == 2) {\n    leb = 1 - parseFloat(leb_value_a) / 100\n  }\n}\nelse if (leb == 0){\n  leb = 1\n}\n\nif (p1 == 1) {\n  if (race == 0) {\n    p1 = 1 - parseFloat(p1_value_w) / 100\n  } else if (race == 1) {\n    p1 = 1 - parseFloat(p1_value_b) / 100\n  } else if (race == 2) {\n    p1 = 1 - parseFloat(p1_value_a) / 100\n  }\n}\nelse if (p1 == 0){\n  p1 = 1\n}\n\nif (lua == 1) {\n  if (race == 0) {\n    lua = 1 - parseFloat(lua_value_w) / 100\n  } else if (race == 1) {\n    lua = 1 - parseFloat(lua_value_b) / 100\n  } else if (race == 2) {\n    lua = 1 - parseFloat(lua_value_a) / 100\n  }\n}\nelse if (lua == 0){\n  lua = 1\n}\n\nif (lub == 1) {\n  if (race == 0) {\n    lub = 1 - parseFloat(lub_value_w) / 100\n  } else if (race == 1) {\n    lub = 1 - parseFloat(lub_value_b) / 100\n  } else if (race == 2) {\n    lub = 1 - parseFloat(lub_value_a) / 100\n  }\n}\nelse if (lub == 0){\n  lub = 1\n}\n\nvar prod = parseFloat(bigk) * parseFloat(lilk) * parseFloat(bigm) * parseFloat(bign) * parseFloat(bigs) * parseFloat(lils) * parseFloat(fya) * parseFloat(fyb) * parseFloat(jka) * parseFloat(jkb) * parseFloat(bigc) * parseFloat(lilc) * parseFloat(bige) * parseFloat(lile) * parseFloat(cw) * parseFloat(lea) * parseFloat(leb) * parseFloat(p1) * parseFloat(lua) * parseFloat(lub) * parseFloat(d) * parseFloat(kpa) * parseFloat(kpb)\n\nvar screening = parseFloat(units) / prod\n\n// if ((screening - Math.floor(screening)) != 0) {\n//  screening = Math.ceil(screening)\n// }\n// else {\n//  screening = screening\n// }\n\nvar msg \n\nif (screening >= 25) {\n  msg = '. Screening a large number of units (≥25) may be impractical for certain blood banks. Consideration of alternative methods to obtain rare units may be desirable (i.e., regional blood donor center, rare blood unit registry).'\n}\nelse {\n  msg = ''\n}\n\nprod = prod*100;\n\ncalc_output.push({\n   name: 'mini',\n   value: screening.toFixed(0),\n   value_text: 'units',\n   message: 'Number of units estimated to be screened'\n});\ncalc_output.push({\n   name: '10011_RBC Compatibility Testing_result (units)',\n   value: screening.toFixed(0),\n   value_text: 'units',\n   message: 'Number of units estimated to be screened' + msg\n});\ncalc_output.push({\n   name: '10011_RBC Compatibility Testing_result (percent)',\n   value: prod.toFixed(0),\n   value_text: '%',\n   message: 'Approximate percent of compatible donor units'\n});",
  "before_use": "Ce calculateur inclut des variables fondées sur la race, qui peuvent ou non fournir de meilleures estimations ; nous avons donc décidé de rendre la race facultative. En savoir plus sur[notre approche](https://www.mdcalc.com/race)de la prise en compte de la race et des biais sur MDCalc.notionvc: 8d8266ae-5341-4471-afce-6878071edeb2",
